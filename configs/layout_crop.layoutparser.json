{
  "backend": "layoutparser_then_template",
  "keep_types": ["Table", "List"],
  "drop_types": ["Title", "Figure", "Text"],
  "combine": "largest",
  "score_threshold": 0.5,
  "min_area_frac": 0.08,
  "padding_px": 0,
  "layoutparser": {
    "engine": "paddle",
    "config_path": "lp://PubLayNet/ppyolov2_r50vd_dcn_365e",
    "detectron2_config_path": "lp://PubLayNet/faster_rcnn_R_50_FPN_3x/config",
    "label_map": {
      "0": "Text",
      "1": "Title",
      "2": "List",
      "3": "Table",
      "4": "Figure"
    },
    "enforce_cpu": true
  },
  "template": {
    "comment": "Fallback: Clinical Information strip + columns. Name header (y<0.08) off. Tubes/office (y>0.82) off. Text is dropped so a Title/header block is not merged into the crop.",
    "top": 0.08,
    "bottom": 0.82,
    "left": 0.0,
    "right": 1.0
  }
}
