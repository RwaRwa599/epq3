{
  "backend": "template",
  "keep_types": ["Table", "List"],
  "drop_types": ["Title", "Figure", "Text"],
  "combine": "largest",
  "score_threshold": 0.5,
  "min_area_frac": 0.08,
  "padding_px": 0,
  "layoutparser": {
    "engine": "paddle",
    "config_path": "lp://PubLayNet/ppyolov2_r50vd_dcn_365e",
    "detectron2_config_path": "lp://PubLayNet/faster_rcnn_R_50_FPN_3x/config",
    "label_map": {
      "0": "Text",
      "1": "Title",
      "2": "List",
      "3": "Table",
      "4": "Figure"
    },
    "enforce_cpu": true
  },
  "template": {
    "comment": "Drop only the name header (page top through just above Clinical Information, ~1cm above column headers). Keep clinical_info, columns, tubes, and office footer to the bottom of the page.",
    "top": 0.08,
    "bottom": 1.0,
    "left": 0.0,
    "right": 1.0
  }
}
